# 最小 Quadlet 示例；高级宿主能力参见上游部署文档。
[Unit]
Description=DeepSeek Harness (dsh) Web UI
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/niyueee/dsh-container:dsh-v0.2.2-rc.2
ContainerName=dsh
PublishPort=127.0.0.1:3081:3081
Volume=dsh-home:/home/dsh
# Volume=/absolute/path/to/package/plugin:/opt/offline-plugins/genui:ro

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
