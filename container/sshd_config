# dsh-container: opt-in, key-only SSH server for the `dsh` user.
#
# This is a COMPLETE, standalone sshd configuration: dsh-web starts the daemon as
# `/usr/sbin/sshd -f /etc/ssh/sshd_config.dsh ...`, so the distribution's
# /etc/ssh/sshd_config is deliberately NOT read (no Include, no distro defaults a
# rebuild could change under us). Everything the daemon needs is spelled out here,
# including the two HostKey paths that live inside the data volume.
#
# Exposure model (see docs/security.md): the proxy on 3081 stays the only
# authenticated remote path by default; this daemon is started only when
# DSH_SSH_ENABLED is truthy, and even then it is reachable only if the operator
# publishes the port. Authentication is public key only — the container has no
# password database worth trusting, so nothing else is offered. A successful login
# is a shell with passwordless sudo, i.e. root-equivalent: treat the SSH port with
# the same care as a root password.

Port 22
ListenAddress 0.0.0.0
AddressFamily any

# Host keys are generated at first start (root-owned, 0600) inside the data volume
# at $HOME/.ssh/host, so they survive container recreation instead of silently
# rotating (a rotated host key makes every client refuse to connect).
HostKey /home/dsh/.ssh/host/ssh_host_ed25519_key
HostKey /home/dsh/.ssh/host/ssh_host_rsa_key

# Public key only. PasswordAuthentication/KbdInteractiveAuthentication are the
# interactive methods an attacker would use, so both are off; PAM is off because
# there is no session manager in this container and pam_loginuid fails there.
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AuthorizedKeysFile .ssh/authorized_keys
StrictModes yes
PermitRootLogin no
UsePAM no
MaxAuthTries 6

# Forwarding: TCP forwarding stays on (that is how `ssh -L` tunnels are built),
# everything else is off — no X11, no agent forwarding, no tun device.
AllowTcpForwarding yes
X11Forwarding no
AllowAgentForwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
MaxSessions 10
ClientAliveInterval 60
ClientAliveCountMax 3

# sftp/scp/rsync over SSH; internal-sftp keeps this file self-contained.
Subsystem sftp internal-sftp

PrintMotd no
AcceptEnv LANG LC_*
LogLevel INFO
SyslogFacility AUTH
PidFile /run/sshd.pid
