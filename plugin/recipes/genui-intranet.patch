+export interface MapTileSettings {
+  url: string
+  scheme?: 'xyz' | 'tms'
+  tileSize?: number
+  minZoom?: number
+  maxZoom?: number
+  attribution?: string
+}
+
+// 配置仅由宿主提供，不读取模型生成的围栏。
+export function mapTileStyle(value: unknown) {
+  if (value === undefined || value === null) return undefined
+  if (typeof value !== 'object') throw new Error('mapTiles must be an object')
+  const v = value as Record<string, unknown>
+  if (typeof v.url !== 'string' || !['{z}', '{x}', '{y}'].every(key => (v.url as string).includes(key))) {
+    throw new Error('mapTiles.url must contain {z}, {x}, {y}')
+  }
+  const url = new URL(v.url, 'http://genui.invalid')
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password
+    || (!/^https?:\/\//i.test(v.url) && !/^\/(?!\/)/.test(v.url))) {
+    throw new Error('mapTiles.url must be HTTP(S) or a root-relative path without credentials')
+  }
+  if (v.scheme !== undefined && v.scheme !== 'xyz' && v.scheme !== 'tms') throw new Error('Invalid tile scheme')
+  for (const [key, fallback, maximum] of [['tileSize', 256, 4096], ['minZoom', 0, 20], ['maxZoom', 20, 20]] as const) {
+    const n = v[key] ?? fallback
+    if (typeof n !== 'number' || !Number.isInteger(n) || n < (key === 'tileSize' ? 1 : 0) || n > maximum) {
+      throw new Error(`Invalid mapTiles.${key}`)
+    }
+  }
+  if (Number(v.minZoom ?? 0) > Number(v.maxZoom ?? 20)) throw new Error('Invalid tile zoom range')
+  if (v.attribution !== undefined && typeof v.attribution !== 'string') throw new Error('Invalid attribution')
+  return {
+    version: 8 as const,
+    sources: {
+      'genui-intranet': {
+        type: 'raster', tiles: [v.url], scheme: v.scheme ?? 'xyz',
+        tileSize: v.tileSize ?? 256, minzoom: v.minZoom ?? 0, maxzoom: v.maxZoom ?? 20,
+        attribution: v.attribution ?? '',
+      },
+    },
+    layers: [{ id: 'genui-intranet', type: 'raster', source: 'genui-intranet' }],
+  }
+}
